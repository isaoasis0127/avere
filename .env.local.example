# このファイルを .env.local という名前でコピーして値を入れてください。
# Netlify では同じ項目を環境変数に登録します（netlify env:import .env.local）。

# --- Firebase（Firebase コンソール > プロジェクトの設定 > マイアプリ）---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Cloudflare R2（画像の保存先。サーバー側のみで使用）---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=avere-images
# 画像の公開 URL（末尾の / なし）例: https://pub-xxxxxxxx.r2.dev または https://img.example.com
R2_PUBLIC_URL=

# --- AI 紹介文生成（サーバー側のみで使用。NEXT_PUBLIC_ を付けないこと）---
ANTHROPIC_API_KEY=
# 使用モデル（省略時 claude-sonnet-5-5）
# ANTHROPIC_MODEL=claude-sonnet-5-5

# 公開サイトの URL（OGP に使用）例: https://avere.example.com
NEXT_PUBLIC_SITE_URL=
